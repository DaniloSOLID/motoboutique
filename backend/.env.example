# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=motoboutique
DB_USER=postgres
DB_PASSWORD=

# Administrador inicial (se crea una sola vez, si no existe)
ADMIN_EMAIL=admin@motoboutique.local
ADMIN_PASSWORD=

# Contraseña común de los usuarios demo (solo perfil dev). Si queda vacía, no se crean.
DEMO_PASSWORD=

# Orígenes del frontend autorizados (CORS), separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Solo perfil prod: SameSite de la cookie de sesión (lax si frontend y API comparten sitio; none si no)
# SESSION_COOKIE_SAME_SITE=lax

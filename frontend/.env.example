# URL base de la API. Déjala vacía en desarrollo: Vite reenvía /api al backend (proxy).
# Si el frontend se publica en otro origen, pon aquí la URL del backend (p. ej. https://api.tudominio.pe)
# y agrégala a CORS_ALLOWED_ORIGINS en el backend.
VITE_API_BASE_URL=

# Solo desarrollo: dirección del backend a la que el proxy de Vite reenvía /api
VITE_DEV_PROXY_TARGET=http://localhost:8081
